BOT_TOKEN=123456:replace_with_botfather_token
LOG_LEVEL=INFO

# Telegram currently accepts audio uploads up to 50 MB for bots.
TELEGRAM_MAX_AUDIO_MB=49
SEARCH_RESULTS_LIMIT=5
MAX_QUERY_LENGTH=120
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=4
MAX_ACTIVE_DOWNLOADS_PER_USER=1
TELEGRAM_SINGLE_INSTANCE_LOCK=true
TELEGRAM_LOCK_STALE_SECONDS=120
TELEGRAM_POLLING_TIMEOUT=10
TELEGRAM_TASKS_CONCURRENCY_LIMIT=20

DATA_DIR=data
TMP_DIR=tmp
CACHE_DB_PATH=data/cache.sqlite3
PREFERRED_AUDIO_CODEC=mp3
YTDLP_SOCKET_TIMEOUT=20

# iMusic is the default search/download provider on Railway.
IMUSIC_FALLBACK_ENABLED=true
IMUSIC_BASE_URL=https://two.imusic.fm/
IMUSIC_TIMEOUT=8

# YouTube search is disabled by default when iMusic is enabled.
# Set YOUTUBE_SEARCH_ENABLED=true only if you need YouTube as a fallback.
# YOUTUBE_SEARCH_ENABLED=false

# Required only when YOUTUBE_SEARCH_ENABLED=true on Railway/datacenter IPs.
# Railway has a per-variable length limit,
# so large cookies should be split into numbered chunks:
# YT_DLP_COOKIES_B64_1=
# YT_DLP_COOKIES_B64_2=
# YT_DLP_COOKIES_B64_3=
#
# Single-variable mode still works outside Railway if the value is short enough:
# YT_DLP_COOKIES_B64=
# YT_DLP_COOKIES_FILE=data/youtube_cookies.txt
# YT_DLP_PROXY=socks5://127.0.0.1:1080
# YT_DLP_PLAYER_CLIENTS=android_vr,tv_embedded,web_safari
